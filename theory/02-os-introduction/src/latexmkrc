# Builds both variants of the presentation next to this directory, and keeps
# every intermediate file in build/. Run `latexmk` (or `make`) from here.
#
#   ../02-os-introduction__presentation.pdf            every slide whole
#   ../02-os-introduction__presentation-segmented.pdf  revealed step by step
@default_files = ('02-os-introduction__presentation.tex',
                  '02-os-introduction__presentation-segmented.tex');
$pdf_mode = 1;
$aux_dir = 'build';
$out_dir = '..';
# Stop at the first error instead of waiting for input that never comes.
set_tex_cmds('-interaction=nonstopmode -halt-on-error -file-line-error %O %S');
